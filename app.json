{
  "expo": {
    "name": "ShiftNote AU",
    "slug": "shiftnote-au",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050A18"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "au.com.shiftnote.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ShiftNote AU requires microphone access so independent NDIS support workers can record post-shift clinical voice notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050A18"
      },
      "package": "au.com.shiftnote.app",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow ShiftNote AU to access your microphone to record post-shift clinical voice notes."
        }
      ]
    ],
    "scheme": "shiftnote"
  }
}

